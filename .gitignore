# ---------------------------------------------------------------- caches
__pycache__/
*.pyc

# ------------------------------------------- bulk price data (regenerable)
# Hundreds of MB of downloaded OHLCV. build_training_data.py regenerates
# whatever is needed from yfinance, so none of this belongs in the repo.
/data/
/data_new/
/data_batch2/
/data_batch3/
/data_batch4/
/data_crash_2022/
/data_nifty500_10y/
/output/
/rsi,bbw/

# ------------------------------------------------ generic local artefacts
*.log
*.png
*.csv

# --------------------------------------------------- experiment output
# results/ is a scratch directory of one-off experiments. Ignore the contents,
# but keep the handful of artifacts the model cannot be reproduced or audited
# without.
#
# Note "/results/*" and not "/results/": git cannot re-include a file whose
# parent directory is itself excluded, so the directory must stay visible.
/results/*
!/results/xgboost_training_data.csv
!/results/nifty500_10y_training_data.csv
!/results/xgboost_oos_predictions_asymmetric.csv

# Retraining reports and candidate models are reviewed in pull requests, so they
# must be committed even though they contain csv.
!/model_reports/**

# ------------------------------------------------------ editor / scratch
.vscode/
.uitest/
.vercel/

# --------------------------------------------------------------- python
# Only the scripts the live pipeline, the dashboard and the retraining
# workflow depend on. Everything else in the workspace is exploratory.
*.py
!daily_scanner.py
!build_dashboard.py
!build_backtest.py
!build_training_data.py
!build_watchlist.py
!retrain.py
!rebuild_history_from_git.py
!extract_ml_features.py
!extract_nifty500_features.py
!train_xgboost_asymmetric.py
